# ==============================================================================
# Berita Duka WebApp - Environment Configuration
# All application parameters are configurable via this file. No hardcoding.
# ==============================================================================

# Server & Runtime Environment
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
SITE_NAME="Portal Berita Duka & Lelayu Digital"

# Neon PostgreSQL Database Connection String
# Example Neon DSN format:
# postgresql://<user>:<password>@<neon-endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/berita_duka?sslmode=disable

# Database Pool Settings (Optimized for Neon Serverless / Vercel Serverless)
AUTO_MIGRATE=true
MAX_DB_CONNS=10
MIN_DB_CONNS=2
DB_CONN_TIMEOUT_SEC=10

# Automatic Purging Service Settings
# Deletes obituaries and records older than PURGE_RETENTION_DAYS after funeral
PURGE_RETENTION_DAYS=30
# Secret Bearer token required to trigger /api/purge (matching Vercel Cron or webhook)
CRON_SECRET=super-secret-cron-token-change-in-production

# Upload & Media Limits
MAX_UPLOAD_SIZE_MB=5
DEFAULT_OBITUARY_PHOTO_URL="https://images.unsplash.com/photo-1518495973542-4542c06a5843?auto=format&fit=crop&w=800&q=80"
